{
  "name": "@dsh-teamwork/dsh-teamwork",
  "version": "0.19.2",
  "description": "Shared team models, agent presets, and approved plugins for DeepSeek Harness",
  "icon": "icon.svg",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-teamwork/dsh-teamwork.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-teamwork": "lib/teamwork-cli.js",
    "dsh-teamwork-audit": "lib/audit-cli.js"
  },
  "files": [
    "lib",
    "skills",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.zh-CN.md",
    "docs",
    "assets/readme",
    "screenshots.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "watch": "tsc -w & node scripts/build-web.mjs --watch",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && pnpm --filter @dsh-teamwork/ui typecheck",
    "test": "vitest run && pnpm --filter @dsh-teamwork/ui test",
    "cli": "tsx src/cli.ts",
    "dev": "node scripts/dev.mjs start",
    "dev:setup": "node scripts/dev.mjs setup",
    "dev:reset": "node scripts/dev.mjs reset",
    "test:host": "node tests/host/run.mjs",
    "test:presets": "node tests/host/run.mjs --presets",
    "test:assistant": "node tests/host/run.mjs --assistant",
    "test:cloud": "node tests/host/run.mjs --cloud"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-plugin-manager": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "devDependencies": {
    "@dsh-teamwork/ui": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.25.12",
    "react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.3",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@chainsafe/libp2p-noise": "16.1.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@hpke/core": "1.7.5",
    "@libp2p/crypto": "5.0.15",
    "@libp2p/logger": "5.1.21",
    "@libp2p/peer-id": "5.0.16",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/web/client.js",
    "./package.json": "./package.json"
  },
  "homepage": "https://www.dshteamwork.com",
  "bugs": {
    "url": "https://github.com/dsh-teamwork/dsh-teamwork/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "teamwork",
    "collaboration",
    "team-configuration",
    "agent-presets",
    "plugin-sharing",
    "usage",
    "budgets"
  ]
}
