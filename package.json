{
  "name": "@dsh-teamwork/dsh-teamwork",
  "version": "0.1.0",
  "description": "Team collaboration plugin for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "prepublishOnly": "pnpm build"
  },
  "dsh": {
    "client": {
      "inject": ["dshTeamwork"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
