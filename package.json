{
  "name": "@dsh-teamwork/dsh-teamwork",
  "version": "0.4.0",
  "description": "Team collaboration plugin for DeepSeek Harness",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-teamwork/dsh-teamwork.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "watch": "tsc -w & node scripts/build-web.mjs --watch",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && pnpm --filter @dsh-teamwork/ui typecheck",
    "test": "vitest run && pnpm --filter @dsh-teamwork/ui test",
    "cli": "tsx src/cli.ts",
    "test:host": "node tests/host/run.mjs",
    "test:presets": "node tests/host/run.mjs --presets"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.25.12",
    "react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@dsh-teamwork/ui": "workspace:*"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@earendil-works/pi-ai": "1.3.0",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/web/client.js",
    "./package.json": "./package.json"
  }
}
